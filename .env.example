# Copy to .env.local and fill in. All are public (inlined into the browser bundle).

# EmailJS (https://dashboard.emailjs.com). One template serves every form: RFQ, lookbook request, cart invoice request.
# Template variables: {{form}} {{subject}} {{name}} {{reply_to}} {{message}}
#   Subject:  [{{form}}] {{subject}}      Reply To: {{reply_to}}
#   Body:     <div style="white-space: pre-line">{{message}}</div>   (keeps the line breaks)
# Template settings: enable "reCAPTCHA V2 verification" and paste the reCAPTCHA secret key there.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google reCAPTCHA v2 "I'm not a robot" checkbox site key (https://www.google.com/recaptcha/admin).
# Add localhost and the production domain to the key's domain list.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
